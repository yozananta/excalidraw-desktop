{
  "name": "excalidraw-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial Electron desktop build of the open-source Excalidraw whiteboard",
  "author": "yozananta",
  "license": "MIT",
  "homepage": "https://github.com/excalidraw/excalidraw",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.yozananta.excalidraw-desktop",
    "productName": "Excalidraw",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../excalidraw-app/build",
        "to": "app-build"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Excalidraw.exe"
    }
  }
}
